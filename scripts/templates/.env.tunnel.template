# ==============================================================================
# Supabase Instance Environment Configuration - Tunnel / Custom Domain Template
# Instance: ${INSTANCE_NAME}
# Base Domain: ${BASE_DOMAIN} (Ex: jcode.api.br)
# ==============================================================================

############
# General & Instance Identity
############
INSTANCE_NAME=${INSTANCE_NAME}

############
# Domain & Tunnel Configuration
# Se seu túnel expõe subdomínios (ex: Cloudflare Tunnel, FRP, Ngrok):
#
# Modo Padrão (2 Subdomínios):
#   - API Gateway:    https://${SUBDOMAIN}.${BASE_DOMAIN}        (Ex: https://afp.jcode.api.br)
#   - Dashboard Web:  https://${SUBDOMAIN}-studio.${BASE_DOMAIN} (Ex: https://afp-studio.jcode.api.br)
############
BASE_DOMAIN=jcode.api.br
SUBDOMAIN=afp

# URL pública que o frontend/cliente e o navegador usam para acessar a API do Supabase
API_EXTERNAL_URL=https://${SUBDOMAIN}.${BASE_DOMAIN}
SUPABASE_PUBLIC_URL=https://${SUBDOMAIN}.${BASE_DOMAIN}

# URL pública onde o Dashboard (Studio) ou seu app web principal está hospedado
SITE_URL=https://${SUBDOMAIN}-studio.${BASE_DOMAIN}

# URLs autorizadas para redirecionamento após autenticação (Magic Link, OAuth)
GOTRUE_URI_ALLOW_LIST=https://${SUBDOMAIN}.${BASE_DOMAIN},https://${SUBDOMAIN}.${BASE_DOMAIN}/**,https://${SUBDOMAIN}-studio.${BASE_DOMAIN},https://${SUBDOMAIN}-studio.${BASE_DOMAIN}/**,http://localhost:3000,http://localhost:3000/**

############
# Host Ports (Portas mapeadas no Host para o Túnel apontar)
############
# No seu túnel, aponte:
#   https://afp.jcode.api.br        -> http://localhost:${KONG_HTTP_PORT}
#   https://afp-studio.jcode.api.br -> http://localhost:${STUDIO_PORT}
KONG_HTTP_PORT=54331
KONG_HTTPS_PORT=54338
STUDIO_PORT=54333
POSTGRES_PORT=54332
REST_PORT=54335
AUTH_PORT=54336
STORAGE_PORT=54339
REALTIME_PORT=54340
META_PORT=54341
INBUCKET_PORT=54334

############
# Database (PostgreSQL)
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_VERSION=15.6.1.143

############
# Secrets & Cryptographic Keys
############
JWT_SECRET=${JWT_SECRET}
ANON_KEY=${ANON_KEY}
SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
JWT_EXPIRY=3600

# Studio Basic Auth (Login no painel web)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=${DASHBOARD_PASSWORD}

# Security Keys
SECRET_KEY_BASE=${SECRET_KEY_BASE}
VAULT_ENC_KEY=${VAULT_ENC_KEY}

############
# Email / Auth Configuration
############
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@${BASE_DOMAIN}
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase

############
# Storage Configuration
############
STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
FILE_SIZE_LIMIT=52428800
GLOBAL_S3_BUCKET=supabase-storage

############
# PostgREST Data API
############
PGRST_MAX_ROWS=1000
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

############
# Pooler & Performance
############
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100

# ==============================================================================
# Supabase Instance Environment Configuration
# Instance: ${INSTANCE_NAME}
# Generated automatically by Supabase Manager
# ==============================================================================

############
# General
############
INSTANCE_NAME=${INSTANCE_NAME}

# URLs Externas / Túnel (Ex: https://afp.jcode.api.br)
SITE_URL=${SITE_URL}
API_EXTERNAL_URL=${API_EXTERNAL_URL}
SUPABASE_PUBLIC_URL=${SUPABASE_PUBLIC_URL}
GOTRUE_URI_ALLOW_LIST=${GOTRUE_URI_ALLOW_LIST}

############
# Ports
############
POSTGRES_PORT=${POSTGRES_PORT}
KONG_HTTP_PORT=${KONG_HTTP_PORT}
KONG_HTTPS_PORT=${KONG_HTTPS_PORT}
STUDIO_PORT=${STUDIO_PORT}
REST_PORT=${REST_PORT}
AUTH_PORT=${AUTH_PORT}
STORAGE_PORT=${STORAGE_PORT}
REALTIME_PORT=${REALTIME_PORT}
META_PORT=${META_PORT}

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_VERSION=15.6.1.143

############
# PostgREST Data API
############
PGRST_MAX_ROWS=1000
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

############
# Secrets & Auth
############
JWT_SECRET=${JWT_SECRET}
ANON_KEY=${ANON_KEY}
SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
JWT_EXPIRY=315360000

# Studio Basic Auth
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=${DASHBOARD_PASSWORD}

# Security Keys
SECRET_KEY_BASE=${SECRET_KEY_BASE}
VAULT_ENC_KEY=${VAULT_ENC_KEY}

############
# Email / SMTP (Optional Mock Default)
############
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase

############
# Storage
############
STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
GLOBAL_S3_BUCKET=supabase-storage
FILE_SIZE_LIMIT=52428800

############
# Pooler & Performance
############
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100

############
# Reverse Tunnels (jcode.api.br)
############
ENABLE_TUNNEL=true
TUNNEL_DOMAIN=${TUNNEL_DOMAIN:-jcode.api.br}
TUNNEL_SERVER=${TUNNEL_SERVER:-wss://jcode.api.br}
TUNNEL_AUTH_TOKEN=${TUNNEL_AUTH_TOKEN:-user_token_abc}

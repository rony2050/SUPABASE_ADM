FROM node:20-alpine

# Instalar Docker CLI, Docker Compose plugin, openssl, bash, curl, jq
RUN apk add --no-cache \
    docker-cli \
    docker-cli-compose \
    openssl \
    bash \
    curl \
    jq \
    coreutils \
    net-tools \
    dos2unix

WORKDIR /app

# Copiar scripts
COPY scripts/ /opt/supabase-manager/scripts/
RUN cd /opt/supabase-manager/scripts/tunnel && npm install --production && \
    dos2unix /opt/supabase-manager/scripts/*.sh /opt/supabase-manager/scripts/lib/*.sh /opt/supabase-manager/scripts/tunnel/*.js 2>/dev/null || true && \
    chmod +x /opt/supabase-manager/scripts/*.sh /opt/supabase-manager/scripts/lib/*.sh && \
    ln -sf /opt/supabase-manager/scripts/supabase-ctl.sh /usr/local/bin/supabase-ctl

# Compilar frontend
COPY client/package*.json ./client/
RUN cd client && npm install
COPY client/ ./client/
RUN cd client && npm run build

# Compilar backend
COPY server/package*.json ./server/
RUN cd server && npm install
COPY server/ ./server/
RUN cd server && npm run build

WORKDIR /app/server

ENV PORT=8585
ENV NODE_ENV=production
ENV SUPABASE_MANAGER_DIR=/opt/supabase-manager

EXPOSE 8585

CMD ["node", "dist/index.js"]
